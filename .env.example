# Telegram Bot Token (required)
# Obtain from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Bot admin User IDs (comma-separated)
# Use the /myid command to get your User ID
# Example: BOT_ADMIN_IDS=123456789,987654321
BOT_ADMIN_IDS=

# Database path
DATABASE_PATH=/data/bot.db

# Image cache path
IMAGE_CACHE_PATH=/images

# Default UI language (zh or en). Per-user language overrides this.
DEFAULT_LANGUAGE=zh

# Verification parameters
VERIFY_IMAGE_COUNT=3          # Number of images shown during verification
VERIFY_REQUIRED_CORRECT=2     # Number that must be answered correctly
VERIFY_TIMEOUT_SECONDS=120    # Verification timeout (seconds)
VERIFY_MAX_RETRY=1            # Maximum retries
VERIFY_DISTRACTOR_COUNT=3     # Distractor options (total = images + distractors)

# Anti-spam: cooldown in seconds for users who rejoin
REJOIN_COOLDOWN_SECONDS=300

# First-failure tempban duration. After a failed/expired verification,
# the user is tempbanned for this many seconds (Telegram auto-lifts).
# A real ban (vs. kick+unban) clears any pre-scheduled messages the
# user may have queued, defeating the scheduled-message spam exploit.
VERIFY_TEMPBAN_SECONDS=300

# Leaderboard channel (negative ID for channels/supergroups). Optional.
# When set, the bot maintains a single pinned/edited message with the top
# 20 fastest verification times.
LEADERBOARD_CHANNEL_ID=
LEADERBOARD_MESSAGE_ID=

# Daily stats: IANA timezone used for the 00:05 daily summary post that
# goes to LEADERBOARD_CHANNEL_ID.
DAILY_STATS_TIMEZONE=Asia/Shanghai
